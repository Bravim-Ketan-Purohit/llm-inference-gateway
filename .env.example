GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=7501
GATEWAY_ENV=development
GATEWAY_LOG_LEVEL=info
GATEWAY_REDACT_PROMPTS=false
API_KEYS=dev-key-1,dev-key-2
REDIS_URL=redis://localhost:7502
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
VLLM_BASE_URL=
VLLM_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CACHE_SEMANTIC_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600
CACHE_MAX_TEMPERATURE=0.2
CACHE_REPLAY_RATE_TOKENS_PER_SEC=200
PGVECTOR_URL=postgresql://postgres:postgres@localhost:7507/gateway
DYNAMODB_TABLE=llm-gateway-usage
DYNAMODB_ENDPOINT_URL=http://localhost:7509
DYNAMODB_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:7511
OTEL_SERVICE_NAME=llm-inference-gateway
